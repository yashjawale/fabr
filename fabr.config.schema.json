{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"title": "Fabr Configuration",
	"description": "Configuration for find-and-replace, file renaming, environment files, and setup commands.",
	"type": "object",
	"properties": {
		"$schema": { "type": "string" },
		"preSetupCommand": {
			"type": "string",
			"description": "Command to run before template processing."
		},
		"postSetupCommand": {
			"type": "string",
			"description": "Command to run after template processing."
		},
		"placeholders": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"key": { "type": "string", "pattern": "^[A-Z_][A-Z0-9_]*$" },
					"prompt": { "type": "string" },
					"default": { "type": "string" }
				},
				"required": ["key", "prompt"],
				"additionalProperties": false
			}
		},
		"environmentVariables": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"key": { "type": "string", "pattern": "^[A-Z_][A-Z0-9_]*$" },
					"prompt": { "type": "string" },
					"default": { "type": "string" },
					"local": { "type": "boolean", "default": false }
				},
				"required": ["key"],
				"additionalProperties": false
			}
		},
		"renamedFiles": {
			"type": "array",
			"description": "Explicit file path changes. Keep source filenames usable without Fabr; use {{PLACEHOLDER}} tokens in destination paths for customized names.",
			"items": {
				"type": "object",
				"properties": {
					"from": { "type": "string" },
					"to": { "type": "string" }
				},
				"required": ["from", "to"],
				"additionalProperties": false
			}
		}
	},
	"additionalProperties": false,
	"examples": [
		{
			"preSetupCommand": "echo 'Preparing project'",
			"placeholders": [{ "key": "PLUGIN_SLUG", "prompt": "Plugin slug?" }],
			"renamedFiles": [{ "from": "plugin.php", "to": "{{PLUGIN_SLUG}}.php" }],
			"environmentVariables": [{ "key": "API_KEY", "prompt": "API key?", "local": true }],
			"postSetupCommand": "npm install"
		}
	]
}
