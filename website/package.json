{
	"name": "website",
	"type": "module",
	"version": "0.0.1",
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"preview": "astro preview",
		"astro": "astro",
		"lint": "eslint src --ext .js,.jsx,.ts,.tsx,.astro",
		"lint:fix": "eslint src --ext .js,.jsx,.ts,.tsx,.astro --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"typecheck": "astro check",
		"ci": "npm run lint && npm run format:check && npm run typecheck && npm run build"
	},
	"dependencies": {
		"@astrojs/starlight": "^0.42.4",
		"@astrojs/starlight-tailwind": "^5.0.0",
		"@fontsource/amaranth": "^5.3.0",
		"@pasqal-io/starlight-client-mermaid": "^0.1.0",
		"@tailwindcss/vite": "^4.3.3",
		"astro": "^7.3.5",
		"mermaid": "^12.0.0",
		"playwright": "^1.63.0",
		"rehype-mermaid": "^3.0.0",
		"starlight-typedoc": "^0.23.1",
		"tailwindcss": "^4.1.12",
		"typedoc": "^0.28.20",
		"typedoc-plugin-markdown": "^4.13.1"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"@eslint/js": "^10.0.1",
		"@typescript-eslint/eslint-plugin": "^8.70.1",
		"@typescript-eslint/parser": "^8.17.0",
		"eslint": "^10.11.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-astro": "^3.2.1",
		"prettier": "^3.4.2",
		"prettier-plugin-astro": "^1.1.0",
		"typescript": "^7.0.2"
	}
}
