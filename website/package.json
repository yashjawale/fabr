{
	"name": "website",
	"type": "module",
	"version": "0.0.1",
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"preview": "astro preview",
		"astro": "astro",
		"lint": "eslint src --ext .js,.jsx,.ts,.tsx,.astro",
		"lint:fix": "eslint src --ext .js,.jsx,.ts,.tsx,.astro --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"typecheck": "astro check",
		"ci": "npm run lint && npm run format:check && npm run typecheck && npm run build"
	},
	"dependencies": {
		"@astrojs/starlight": "^0.37.0",
		"@astrojs/starlight-tailwind": "^4.0.2",
		"@fontsource/amaranth": "^5.2.8",
		"@pasqal-io/starlight-client-mermaid": "^0.1.0",
		"@tailwindcss/vite": "^4.1.17",
		"astro": "^5.16.3",
		"mermaid": "^11.12.1",
		"playwright": "^1.57.0",
		"rehype-mermaid": "^3.0.0",
		"starlight-typedoc": "^0.21.5",
		"tailwindcss": "^4.1.12",
		"typedoc": "^0.28.15",
		"typedoc-plugin-markdown": "^4.9.0"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.6",
		"@eslint/js": "^9.39.1",
		"@typescript-eslint/eslint-plugin": "^8.48.0",
		"@typescript-eslint/parser": "^8.17.0",
		"eslint": "^9.39.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-astro": "^1.5.0",
		"prettier": "^3.7.3",
		"prettier-plugin-astro": "^0.14.1",
		"typescript": "^5.9.3"
	}
}
